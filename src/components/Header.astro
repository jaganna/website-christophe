---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useTranslations, getLocalizedPath, getBlogPath } from "../i18n/utils";
import type { Locale } from "../i18n/translations";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const homePath = getLocalizedPath("/", lang);
---

<header class="mb-12">
  <!-- Language switcher: top-right corner -->
  <div class="flex justify-end mb-4">
    <LanguageSwitcher />
  </div>

  <!-- Name + Logo + Menu on one line -->
  <nav class="flex items-center justify-between gap-4">
    <a href={homePath} class="font-serif text-sm font-bold leading-tight shrink-0">
      Andrew<br />Christophe<br />Rodolphe<br />Bach-Bourdelier
    </a>

    <a href={homePath} class="shrink-0">
      <img src="/logo.jpg" alt="Logo" width="80" height="80" class="rounded" />
    </a>

    <div class="flex items-center gap-5 text-sm text-gray-600 shrink-0">
      <a href={`${homePath}#about`}>{t.nav.about}</a>
      <a href={getBlogPath(lang)}>{t.nav.posts}</a>
      <a href={`${homePath}#services`}>{t.nav.services}</a>
    </div>
  </nav>
</header>
