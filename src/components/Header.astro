---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useTranslations, getLocalizedPath, getBlogPath } from "../i18n/utils";
import type { Locale } from "../i18n/translations";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const homePath = getLocalizedPath("/", lang);
---

<header class="mb-12">
  <div class="flex flex-col items-center mb-6">
    <a href={homePath}>
      <img src="/logo.svg" alt="Christophe Bach-Bourdelier" width="200" height="60" />
    </a>
  </div>
  <nav class="flex items-center justify-between">
    <a href={homePath} class="font-serif text-xl font-bold">Christophe Bach-Bourdelier</a>
    <div class="flex items-center gap-6 text-sm text-gray-600">
      <a href={`${homePath === "/" ? "" : homePath}#about`}>{t.nav.about}</a>
      <a href={getBlogPath(lang)}>{t.nav.posts}</a>
      <a href={`${homePath === "/" ? "" : homePath}#services`}>{t.nav.services}</a>
      <LanguageSwitcher />
    </div>
  </nav>
</header>
