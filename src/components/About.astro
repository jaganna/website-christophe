---
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/translations";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const about = t.about;
---

<section id="about" class="mb-16">
  <h2>{about.title}</h2>
  <p class="leading-relaxed text-gray-800 mb-8">{about.profile}</p>

  <h3>{about.experienceTitle}</h3>
  <ul class="space-y-3 mb-8">
    {about.experience.map((exp) => (
      <li>
        <span class="font-semibold">{exp.role}</span>
        <span class="mx-1">&mdash;</span>
        <span class="text-gray-600">{exp.org}</span>
        {exp.period && <span class="text-gray-500 text-sm ml-2">({exp.period})</span>}
      </li>
    ))}
  </ul>

  <h3>{about.educationTitle}</h3>
  <ul class="space-y-3 mb-8">
    {about.education.map((edu) => (
      <li>
        <span class="font-semibold">{edu.degree}</span>
        <span class="mx-1">&mdash;</span>
        <span class="text-gray-600">{edu.school}</span>
        {edu.period && <span class="text-gray-500 text-sm ml-2">({edu.period})</span>}
      </li>
    ))}
  </ul>

  <h3>{about.skillsTitle}</h3>
  <p class="text-gray-700 mb-8">{about.skills}</p>

  <h3>{about.engagementTitle}</h3>
  <p class="text-gray-700">{about.engagement}</p>
</section>
