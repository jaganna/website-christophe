---
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/translations";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const about = t.about;
---

<section id="about">
  <h2 class="mb-8">{about.title}</h2>

  <!-- Photo + profile side by side -->
  <div class="flex flex-col sm:flex-row gap-8 mb-12">
    <img
      src="/christophe-1.png"
      alt="Christophe Bach-Bourdelier"
      width="150"
      height="150"
      class="rounded-lg object-cover w-36 shrink-0 shadow-sm"
    />
    <p class="leading-relaxed text-gray-700 text-lg">{about.profile}</p>
  </div>

  <!-- Experience -->
  <div class="border-t border-gray-200 pt-8 mb-10">
    <h3>{about.experienceTitle}</h3>
    <ul class="space-y-4 mt-4">
      {about.experience.map((exp) => (
        <li>
          <span class="font-semibold">{exp.role}</span>
          <span class="text-gray-400 mx-1">&mdash;</span>
          <span class="text-gray-600">{exp.org}</span>
          {exp.period && <span class="text-gray-400 text-sm ml-2">({exp.period})</span>}
        </li>
      ))}
    </ul>
  </div>

  <!-- Education -->
  <div class="border-t border-gray-200 pt-8 mb-10">
    <h3>{about.educationTitle}</h3>
    <ul class="space-y-4 mt-4">
      {about.education.map((edu) => (
        <li>
          <span class="font-semibold">{edu.degree}</span>
          <span class="text-gray-400 mx-1">&mdash;</span>
          <span class="text-gray-600">{edu.school}</span>
          {edu.period && <span class="text-gray-400 text-sm ml-2">({edu.period})</span>}
        </li>
      ))}
    </ul>
  </div>

  <!-- Skills -->
  <div class="border-t border-gray-200 pt-8 mb-10">
    <h3>{about.skillsTitle}</h3>
    <p class="text-gray-700 mt-4">{about.skills}</p>
  </div>

  <!-- Engagement -->
  <div class="border-t border-gray-200 pt-8 mb-16">
    <h3>{about.engagementTitle}</h3>
    <p class="text-gray-700 mt-4">{about.engagement}</p>
  </div>
</section>
