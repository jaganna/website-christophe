---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<section id="blog" class="mb-16">
  <h2>Blog</h2>
  {
    posts.length === 0 ? (
      <p class="text-gray-500">Aucun article pour le moment.</p>
    ) : (
      <ul class="space-y-4">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group">
              <span class="text-gray-500 text-sm">
                {post.data.date.toLocaleDateString("fr-FR", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </span>
              <span class="mx-2">—</span>
              <span class="group-hover:underline">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
